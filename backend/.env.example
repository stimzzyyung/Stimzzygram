PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/stimzzysgram
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
CLIENT_URL=*

# Cloudinary (optional - if empty, files are saved to /uploads locally)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rizz Bot AI provider: "anthropic" or "openai" (any OpenAI-compatible API)
AI_PROVIDER=anthropic
AI_API_KEY=your_key_here
AI_MODEL=claude-sonnet-5-5
# Only for openai-compatible providers:
AI_BASE_URL=https://api.openai.com/v1
