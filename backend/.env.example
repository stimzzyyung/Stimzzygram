PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/stimzzysgram
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
CLIENT_URL=*

# Cloudinary (optional - if empty, files are saved to /uploads locally)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rizz Bot AI provider: "gemini", "anthropic", or "openai" (OpenAI-compatible)
AI_PROVIDER=gemini
AI_API_KEY=your_key_here
AI_MODEL=gemini-3.8-flash
# Optional provider-specific model overrides
AI_RIZZ_MODEL=gemini-3.8-flash

AI_TRANSLATION_MODEL=gemini-3.8-flash
# Used after a transient Gemini error from the primary model
AI_GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Only for openai-compatible providers:
AI_BASE_URL=https://api.openai.com/v1

# Resend email OTP delivery
RESEND_API_KEY=
# Use a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL=StimzzyVibe <noreply@yourdomain.com>
