{
  "expo": {
    "name": "StimzzyVibe",
    "slug": "stimzzyvibe",
    "scheme": "stimzzyvibe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": { "backgroundColor": "#080C10" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stimzzyvibe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos and videos to share.",
        "NSMicrophoneUsageDescription": "Record voice messages and videos.",
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to share."
      }
    },
    "android": {
      "package": "com.stimzzyvibe.app",
      "adaptiveIcon": { "backgroundColor": "#080C10" },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can share them.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera so you can take photos and videos."
        }
      ],
      "expo-av"
    ]
  }
}
